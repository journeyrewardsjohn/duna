# Keep the standard repository exclusions. EAS gives this file precedence over
# .gitignore, so these rules intentionally mirror the root ignore policy.

# dependencies
node_modules/
.pnpm-store/

# builds and caches
.next/
.expo/
dist/
build/
coverage/
.turbo/
playwright-report/
test-results/
*.tsbuildinfo

# credentials and local state
.env
.env.local
.env.*.local
!.env.example
.vercel/
.neon/

# mobile
apps/*/android/
apps/*/ios/
apps/*/.expo/
apps/*/credentials.json
apps/*/credentials/

# system and editor
.DS_Store
.idea/
.vscode/
*.log
.worktrees/
.codex/worktrees/

# generated brand artifacts that have not been approved
artifacts/

# Server and documentation material not used by either native application.
# Keeping it out of EAS archives makes signed build uploads reliable without
# changing either app's installed workspace dependency graph.
/apps/web/
/apps/hq/
# /docs is excluded except the two inputs the root postinstall needs to
# generate packages/api/src/generated/duna-feature-knowledge.ts (the manifest
# is no longer committed; without these the install phase fails on EAS).
/docs/*
!/docs/surfaces/
!/docs/BUILD_MATRIX.md
/tests/
/.agents/
/packages/db/drizzle/meta/
