{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["EXPO_PUBLIC_*", "NEXT_PUBLIC_*"],
  "globalPassThroughEnv": [
    "AI_GATEWAY_API_KEY",
    "AI_GATEWAY_AVP_MODEL",
    "AI_GATEWAY_EVENT_RESEARCH_MODEL",
    "AI_GATEWAY_PROFILE_MODEL",
    "AI_GATEWAY_SPORTSWRITER_MODEL",
    "APPLE_WALLET_PASS_TYPE_ID",
    "APPLE_WALLET_SIGNER_CERT_BASE64",
    "APPLE_WALLET_SIGNER_KEY_BASE64",
    "APPLE_WALLET_SIGNER_KEY_PASSPHRASE",
    "APPLE_WALLET_TEAM_ID",
    "APPLE_WALLET_WWDR_CERT_BASE64",
    "APNS_BUNDLE_ID",
    "APNS_KEY_ID",
    "APNS_PRIVATE_KEY",
    "APNS_TEAM_ID",
    "AXIOM_TOKEN",
    "BLOB_READ_WRITE_TOKEN",
    "CE_SECRET_ACCESS_KEY",
    "CF_ACCESS_KEY_ID",
    "CF_TOKEN_VALUE",
    "CLOUDFLARE_ACCOUNT_ID",
    "CRON_SECRET",
    "DATABASE_URL",
    "DUNA_COPILOT_MODEL",
    "DUNA_ADMIN_EMAILS",
    "DUNA_DATA_SOURCE",
    "DUNA_WALLET_DOWNLOAD_SECRET",
    "DUNA_SUPER_ADMIN_EMAILS",
    "FIRECRAWL_API",
    "FIRECRAWL_API_KEY",
    "GOOGLE_PLACES_API_KEY",
    "HEALTH_DATA_ENCRYPTION_KEY",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "KNOCK_SECRET_API_KEY",
    "LIVEKIT_API_KEY",
    "LIVEKIT_API_SECRET",
    "LIVEKIT_URL",
    "MUX_DATA_ENV_KEY",
    "MUX_PRIVATE_KEY",
    "MUX_SECRET_KEY",
    "MUX_SIGNING_KEY",
    "MUX_SIGNING_KEY_ID",
    "MUX_SIGNING_SECRET",
    "MUX_TOKEN_ID",
    "MUX_TOKEN_SECRET",
    "MUX_WEBHOOK_SECRET",
    "R2_BUCKET_NAME",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "SAND_SCRAPER_ENGINE",
    "SENTRY_AUTH_TOKEN",
    "SENT_DM_API",
    "SENT_DM_API_KEY",
    "SENT_DM_BOOKING_INVITE_TEMPLATE_ID",
    "SENT_DM_BOOKING_INVITE_TEMPLATE_NAME",
    "SENT_DM_PLAYER_INVITE_TEMPLATE_NAME",
    "SENT_DM_SANDBOX",
    "STRIPE_AUTOMATIC_TAX_ENABLED",
    "STRIPE_CLUB_MONTHLY_PRICE_ID",
    "STRIPE_DUNA_PLUS_ANNUAL_PRICE_ID",
    "STRIPE_DUNA_PLUS_MONTHLY_PRICE_ID",
    "STRIPE_IDENTITY_REQUIRE_SELFIE",
    "STRIPE_SECRET_KEY",
    "STRIPE_SMALL_CLUB_MONTHLY_PRICE_ID",
    "STRIPE_WEBHOOK_SECRET",
    "TOMORROW_IO_API_KEY",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_FROM_NUMBER",
    "VERCEL_OIDC_TOKEN",
    "WORKOS_API_KEY",
    "WORKOS_CLIENT_ID",
    "WORKOS_COOKIE_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
