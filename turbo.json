{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["EXPO_PUBLIC_*", "NEXT_PUBLIC_*"],
  "globalPassThroughEnv": [
    "AI_GATEWAY_API_KEY",
    "AXIOM_TOKEN",
    "BLOB_READ_WRITE_TOKEN",
    "CRON_SECRET",
    "DATABASE_URL",
    "DUNA_ADMIN_EMAILS",
    "DUNA_DATA_SOURCE",
    "DUNA_SUPER_ADMIN_EMAILS",
    "FIRECRAWL_API",
    "FIRECRAWL_API_KEY",
    "GOOGLE_PLACES_API_KEY",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "KNOCK_SECRET_API_KEY",
    "LIVEKIT_API_KEY",
    "LIVEKIT_API_SECRET",
    "LIVEKIT_URL",
    "OPENAI_API_KEY",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "SAND_SCRAPER_ENGINE",
    "SENTRY_AUTH_TOKEN",
    "SENT_DM_API",
    "SENT_DM_API_KEY",
    "SENT_DM_BOOKING_INVITE_TEMPLATE_ID",
    "SENT_DM_BOOKING_INVITE_TEMPLATE_NAME",
    "SENT_DM_PLAYER_INVITE_TEMPLATE_NAME",
    "SENT_DM_SANDBOX",
    "STRIPE_AUTOMATIC_TAX_ENABLED",
    "STRIPE_CLUB_MONTHLY_PRICE_ID",
    "STRIPE_DUNA_PLUS_ANNUAL_PRICE_ID",
    "STRIPE_DUNA_PLUS_MONTHLY_PRICE_ID",
    "STRIPE_IDENTITY_REQUIRE_SELFIE",
    "STRIPE_SECRET_KEY",
    "STRIPE_SMALL_CLUB_MONTHLY_PRICE_ID",
    "STRIPE_WEBHOOK_SECRET",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_FROM_NUMBER",
    "WORKOS_API_KEY",
    "WORKOS_CLIENT_ID",
    "WORKOS_COOKIE_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
