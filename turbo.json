{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DUNA_AI_SESSION_SECRET",
    "DUNA_ASK_AGENT_ORIGIN",
    "DUNA_ASK_FAST_MODEL",
    "DUNA_ASK_MODEL",
    "DUNA_ASK_ULTRA_MODEL",
    "EXPO_PUBLIC_*",
    "NEXT_PUBLIC_*",
    "VERCEL_AUTOMATION_BYPASS_SECRET"
  ],
  "globalPassThroughEnv": [
    "AI_GATEWAY_API_KEY",
    "AI_GATEWAY_AVP_MODEL",
    "AI_GATEWAY_EVENT_RESEARCH_MODEL",
    "AI_GATEWAY_PROFILE_MODEL",
    "AI_GATEWAY_SPORTSWRITER_MODEL",
    "APPLE_WALLET_PASS_TYPE_ID",
    "APPLE_WALLET_SIGNER_CERT_BASE64",
    "APPLE_WALLET_SIGNER_KEY_BASE64",
    "APPLE_WALLET_SIGNER_KEY_PASSPHRASE",
    "APPLE_WALLET_TEAM_ID",
    "APPLE_WALLET_WWDR_CERT_BASE64",
    "APNS_BUNDLE_ID",
    "APNS_KEY_ID",
    "APNS_PRIVATE_KEY",
    "APNS_TEAM_ID",
    "AXIOM_TOKEN",
    "BLOB_READ_WRITE_TOKEN",
    "CE_SECRET_ACCESS_KEY",
    "CF_ACCESS_KEY_ID",
    "CF_R2_ACCESS_KEY_ID",
    "CF_R2_S3_ENDPOINT",
    "CF_R2_SECRET_ACCESS_KEY",
    "CF_TOKEN_VALUE",
    "CLOUDFLARE_ACCOUNT_ID",
    "CRON_SECRET",
    "DATABASE_URL",
    "NEON_READ_ONLY_REPLICA",
    "DUNA_ANALYSIS_WORKER_TOKEN",
    "DUNA_ANALYSIS_WORKER_URL",
    "DUNA_COPILOT_MODEL",
    "DUNA_ADMIN_EMAILS",
    "DUNA_DATA_SOURCE",
    "DUNA_LOG_FORMAT",
    "DUNA_LOG_LEVEL",
    "DUNA_WALLET_DOWNLOAD_SECRET",
    "DUNA_SUPER_ADMIN_EMAILS",
    "DUNA_VISION_ATTESTATION_PUBLIC_KEY_PEM",
    "DUNA_VISION_OPERATIONS_URL",
    "FIRECRAWL_API",
    "FIRECRAWL_API_KEY",
    "GOOGLE_PLACES_API_KEY",
    "HEALTH_DATA_ENCRYPTION_KEY",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "KNOCK_SECRET_API_KEY",
    "LIVEKIT_API_KEY",
    "LIVEKIT_API_SECRET",
    "LIVEKIT_URL",
    "R2_BUCKET_NAME",
    "RESEND_API_KEY",
    "RESEND_FROM_EMAIL",
    "SAND_SCRAPER_ENGINE",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_DSN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENT_DM_API",
    "SENT_DM_API_KEY",
    "SENT_DM_BOOKING_INVITE_TEMPLATE_ID",
    "SENT_DM_BOOKING_INVITE_TEMPLATE_NAME",
    "SENT_DM_PLAYER_INVITE_TEMPLATE_NAME",
    "SENT_DM_SANDBOX",
    "STRIPE_AUTOMATIC_TAX_ENABLED",
    "STRIPE_CLUB_MONTHLY_PRICE_ID",
    "STRIPE_DUNA_PLUS_ANNUAL_PRICE_ID",
    "STRIPE_DUNA_PLUS_MONTHLY_PRICE_ID",
    "STRIPE_IDENTITY_REQUIRE_SELFIE",
    "STRIPE_SECRET_KEY",
    "STRIPE_SMALL_CLUB_MONTHLY_PRICE_ID",
    "STRIPE_WEBHOOK_SECRET",
    "TOMORROW_IO_API_KEY",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_FROM_NUMBER",
    "VERCEL_OIDC_TOKEN",
    "WORKOS_API_KEY",
    "WORKOS_CLIENT_ID",
    "WORKOS_COOKIE_PASSWORD"
  ],
  "tasks": {
    "knowledge:generate": {
      "inputs": [
        "$TURBO_ROOT$/scripts/generate-duna-feature-knowledge.ts",
        "$TURBO_ROOT$/docs/BUILD_MATRIX.md",
        "$TURBO_ROOT$/docs/surfaces/**",
        "src/router.ts",
        "src/routers/**"
      ],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^knowledge:generate", "knowledge:generate"],
      "outputs": [".next/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^knowledge:generate", "knowledge:generate"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint", "^knowledge:generate", "knowledge:generate"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^knowledge:generate", "knowledge:generate"]
    },
    "test": {
      "dependsOn": ["^build", "^knowledge:generate", "knowledge:generate"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
