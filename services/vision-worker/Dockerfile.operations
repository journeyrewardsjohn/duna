FROM pytorch/pytorch:2.7.1-cuda12.6-cudnn9-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl ffmpeg git libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
RUN git clone https://github.com/Megvii-BaseDetection/YOLOX.git \
    && cd YOLOX \
    && git checkout 419778480ab6ec0590e5d3831b3afb3b46ab2aa3 \
    && pip install \
        'loguru>=0.7,<1' \
        'onnx==1.18.0' \
        'opencv-python-headless>=4.11,<5' \
        'pycocotools>=2.0.10,<3' \
        'scikit-image>=0.25,<1' \
        'tabulate>=0.9,<1' \
        'tensorboard>=2.20,<3' \
        'thop>=0.1.1,<1' \
    && curl -fsSL https://github.com/Megvii-BaseDetection/YOLOX/releases/download/0.1.1rc0/yolox_s.pth -o /opt/YOLOX/yolox_s.pth

WORKDIR /opt/duna-vision
COPY pyproject.toml ./
COPY src ./src
RUN pip install . \
    && mkdir -p /var/lib/duna-vision/work

ENV PYTHONPATH="/opt/duna-vision/src:/opt/YOLOX"
