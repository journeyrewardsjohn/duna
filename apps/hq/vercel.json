{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"production\" ]; then pnpm --filter @duna/db migrate; fi && pnpm build",
  "crons": [
    {
      "path": "/api/cron/workflows",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/money-payouts",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/money-reconciliation",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/event-operations",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/vision-improvement",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/sand?mode=vw-live",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sand?mode=live",
      "schedule": "15 */2 * * *"
    },
    {
      "path": "/api/cron/sand?mode=avp-tournaments",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/sand?mode=elite-stats",
      "schedule": "17 * * * *"
    }
  ]
}
