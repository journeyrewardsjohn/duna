{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter @duna/db migrate && pnpm build",
  "crons": [
    {
      "path": "/api/cron/sand?mode=vw-live",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sand?mode=live",
      "schedule": "15 */2 * * *"
    },
    {
      "path": "/api/cron/sand?mode=elite-stats",
      "schedule": "17 * * * *"
    }
  ]
}
