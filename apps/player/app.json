{
  "expo": {
    "name": "Duna",
    "slug": "duna-player",
    "scheme": "duna",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.duna.player",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSContactsUsageDescription": "Duna uses contacts you select to find frequent partners or send a one-time game invitation.",
        "NSLocationWhenInUseUsageDescription": "Duna uses your location to show nearby play and venues."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F3EA"
      },
      "package": "com.duna.player",
      "permissions": ["ACCESS_COARSE_LOCATION", "READ_CONTACTS"]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@clerk/expo",
      "expo-contacts",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F7F3EA"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "87615942-8a2d-47e3-9dc4-334e427a5944"
      }
    },
    "owner": "journey-rewards-inc",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/87615942-8a2d-47e3-9dc4-334e427a5944"
    }
  }
}
