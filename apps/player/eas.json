{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_DUNA_PREVIEW": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_DUNA_PREVIEW": "true"
      }
    },
    "preview-simulator": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_DUNA_PREVIEW": "true"
      },
      "ios": {
        "simulator": true
      }
    },
    "testflight": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "testflight",
      "env": {
        "EXPO_PUBLIC_DUNA_PREVIEW": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_DUNA_PREVIEW": "false"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6796792115"
      }
    },
    "production": {}
  }
}
