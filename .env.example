# Runtime
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_HQ_URL=http://localhost:3001
NEXT_PUBLIC_DEMO_MODE=true
DATABASE_URL=

# WorkOS AuthKit
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Generate a random value with at least 32 characters.
WORKOS_COOKIE_PASSWORD=
# Auth routes derive the callback from each request origin. Use this only as a
# fallback for scripts or local tooling that cannot inspect the request.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=
# Mobile builds use the same WorkOS client with registered deep-link redirects.
EXPO_PUBLIC_WORKOS_CLIENT_ID=

# Stripe sandbox
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DUNA_PLUS_MONTHLY_PRICE_ID=
STRIPE_DUNA_PLUS_ANNUAL_PRICE_ID=
STRIPE_SMALL_CLUB_MONTHLY_PRICE_ID=
STRIPE_CLUB_MONTHLY_PRICE_ID=
STRIPE_AUTOMATIC_TAX_ENABLED=false
# Stripe hosts all document and selfie collection. Set false only after a
# deliberate identity-policy review.
STRIPE_IDENTITY_REQUIRE_SELFIE=true

# AI
AI_GATEWAY_API_KEY=
OPENAI_API_KEY=

# LiveKit voice onboarding
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Messaging and workflows
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
KNOCK_SECRET_API_KEY=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Realtime, storage, and observability
ABLY_API_KEY=
BLOB_READ_WRITE_TOKEN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
AXIOM_TOKEN=
