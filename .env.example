# Runtime
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_HQ_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_DUNA_WEB_URL=http://localhost:3000
DUNA_WEB_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true
DUNA_DATA_SOURCE=demo
DATABASE_URL=
# Server-only Neon read-only replica connection string. Eligible, latency-tolerant
# reads use this through getReadOnlyDatabase(); writes and consistent reads stay
# on DATABASE_URL. Falls back to DATABASE_URL when omitted outside production.
NEON_READ_ONLY_REPLICA=
# Server-only platform-role bootstrap allowlists. Leave blank unless an
# explicitly approved environment needs them.
DUNA_ADMIN_EMAILS=
DUNA_SUPER_ADMIN_EMAILS=
# Optional comma-separated additional origins for the public MCP endpoint.
DUNA_MCP_ALLOWED_ORIGINS=
# Bearer used by Vercel/GitHub cron requests. Never expose it to clients.
CRON_SECRET=

# WorkOS AuthKit
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
# Generate a random value with at least 32 characters.
WORKOS_COOKIE_PASSWORD=
# Auth routes derive the callback from each request origin. Use this only as a
# fallback for scripts or local tooling that cannot inspect the request.
NEXT_PUBLIC_WORKOS_REDIRECT_URI=
# Mobile builds use the same WorkOS client with registered deep-link redirects.
EXPO_PUBLIC_WORKOS_CLIENT_ID=

# Expo public runtime. Every value is embedded in the installed app and must be
# treated as public. Configure the matching names in each EAS environment.
EXPO_PUBLIC_DUNA_API_URL=
EXPO_PUBLIC_DUNA_AUTH_URL=
EXPO_PUBLIC_DUNA_WEB_URL=
EXPO_PUBLIC_DUNA_HQ_URL=
EXPO_PUBLIC_DUNA_PREVIEW=true
EXPO_PUBLIC_MAPBOX_API_TOKEN=

# Stripe sandbox
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DUNA_PREMIUM_MONTHLY_PRICE_ID=
STRIPE_DUNA_PREMIUM_ANNUAL_PRICE_ID=
STRIPE_DUNA_PREMIUM_PLUS_MONTHLY_PRICE_ID=
STRIPE_DUNA_PREMIUM_PLUS_ANNUAL_PRICE_ID=
# Legacy Duna+ price aliases remain accepted for existing Premium environments.
STRIPE_DUNA_PLUS_MONTHLY_PRICE_ID=
STRIPE_DUNA_PLUS_ANNUAL_PRICE_ID=
STRIPE_SMALL_CLUB_MONTHLY_PRICE_ID=
STRIPE_SMALL_CLUB_ANNUAL_PRICE_ID=
STRIPE_CLUB_MONTHLY_PRICE_ID=
STRIPE_CLUB_ANNUAL_PRICE_ID=
STRIPE_DUNA_SERVICE_FEE_PRODUCT_ID=
# Duna HQ organization subscriptions. The two legacy monthly aliases above
# remain accepted, but new environments should use this complete catalog.
STRIPE_HQ_CLUB_MONTHLY_PRICE_ID=
STRIPE_HQ_CLUB_ANNUAL_PRICE_ID=
STRIPE_HQ_FACILITY_MONTHLY_PRICE_ID=
STRIPE_HQ_FACILITY_ANNUAL_PRICE_ID=
STRIPE_HQ_NETWORK_MONTHLY_PRICE_ID=
STRIPE_HQ_NETWORK_ANNUAL_PRICE_ID=
# Duna-owned subscriptions. Organization marketplace transactions require Tax
# after Connect onboarding and use the platform's Tax settings/registrations.
STRIPE_AUTOMATIC_TAX_ENABLED=false
# Cash-wallet spending remains off until custody, minors, and ledger operations
# have explicitly approved the environment. Organization credits do not use it.
DUNA_WALLET_CASH_ENABLED=false
# Stripe hosts all document and selfie collection. Set false only after a
# deliberate identity-policy review.
STRIPE_IDENTITY_REQUIRE_SELFIE=true

# AI
AI_GATEWAY_API_KEY=
# Vercel supplies workload OIDC when enabled. Do not hardcode a production
# token; the blank name documents the optional local/non-Vercel fallback.
VERCEL_OIDC_TOKEN=
# Provider-qualified model used only through Vercel AI Gateway by Duna CoPilot.
DUNA_COPILOT_MODEL=openai/gpt-5.6-terra
DUNA_TRAINING_MODEL=openai/gpt-5.6-sol
DUNA_TRAINING_IMAGE_MODEL=gpt_image_2
# Vercel AI Gateway provider/model identifier used for AVP normalization.
AI_GATEWAY_AVP_MODEL=openai/gpt-5.6-luna
AI_GATEWAY_EVENT_RESEARCH_MODEL=openai/gpt-5.6-luna
AI_GATEWAY_PLAYER_RESEARCH_MODEL=openai/gpt-5.6-luna
AI_GATEWAY_PROFILE_MODEL=openai/gpt-5.6-luna
AI_GATEWAY_SPORTSWRITER_MODEL=openai/gpt-5.6-luna
AI_GATEWAY_VIRTUAL_COACHING_MODEL=openai/gpt-5.6-luna
# Provider-qualified model used only through Vercel AI Gateway for evidence-bound Elite tournament analysis.
AI_GATEWAY_TOURNAMENT_ANALYTICS_MODEL=openai/gpt-5.6-luna
AI_GATEWAY_VENUE_LAYOUT_MODEL=openai/gpt-5.6-luna
FIRECRAWL_API_KEY=
# Legacy key alias accepted by source adapters. Prefer FIRECRAWL_API_KEY.
FIRECRAWL_API=
SAND_SCRAPER_ENGINE=

# Duna Messaging agents and youth-safety screening use the OpenAI Agents SDK.
# Keep the key server-side. Content from any minor remains on the human-review
# path unless both zero-data-retention eligibility and verified parental consent
# are present. This fail-closed rule accounts for jurisdiction-specific digital
# consent ages.
OPENAI_API_KEY=
DUNA_AI_MODEL=gpt-5.6
DUNA_SAFETY_MODEL=gpt-5.6
OPENAI_ZERO_DATA_RETENTION_CONFIRMED=false

# Planning, maps, and daylight
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
# Google Workspace service account with domain-wide delegation. The organizer
# must be a licensed Workspace user in the same domain; keep the PEM private.
GOOGLE_WORKSPACE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WORKSPACE_PRIVATE_KEY=
GOOGLE_WORKSPACE_MEET_ORGANIZER_EMAIL=
# Optional; defaults to the organizer's primary calendar.
GOOGLE_WORKSPACE_MEET_CALENDAR_ID=
MAPBOX_API_TOKEN_PUBLIC=
# Compatibility fallback; client token routes accept only a public pk token.
MAPBOX_API_TOKEN=
TOMORROW_IO_API_KEY=

# Optional operator media-generation tooling
HF_CREDENTIALS=
HIGGSFIELD_BIN=
DUNA_MEDIA_CONCURRENCY=3

# Tournament Apple Wallet passes. Keep certificate material in the hosting
# provider's encrypted environment store; values below are base64-encoded PEM.
# Generate an independent random download secret with at least 32 characters.
DUNA_WALLET_DOWNLOAD_SECRET=
APPLE_WALLET_PASS_TYPE_ID=pass.com.duna.tournament
APPLE_WALLET_TEAM_ID=4AMCKQA9GL
APPLE_WALLET_WWDR_CERT_BASE64=
APPLE_WALLET_SIGNER_CERT_BASE64=
APPLE_WALLET_SIGNER_KEY_BASE64=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
# Optional membership-specific signer overrides. When omitted, Membership
# cards use the configured Duna Wallet pass type and signer above.
APPLE_WALLET_MEMBER_PASS_TYPE_ID=
APPLE_WALLET_MEMBER_SIGNER_CERT_BASE64=
APPLE_WALLET_MEMBER_SIGNER_KEY_BASE64=
APPLE_WALLET_MEMBER_SIGNER_KEY_PASSPHRASE=

# Duna Video — Mux live ingest, secure playback, recordings, and Data
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Mux dashboard alias also accepted: MUX_SECRET_KEY
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
# Paste the complete PEM or Mux base64 secret; escaped \n newlines are accepted.
MUX_PRIVATE_KEY=
# Mux dashboard alias also accepted: MUX_SIGNING_SECRET
MUX_DATA_ENV_KEY=

# Duna Health — encrypt imported HealthKit payloads before database storage.
# Required in every server environment; use a base64-encoded 32-byte key.
HEALTH_DATA_ENCRYPTION_KEY=

# Duna Video — private Cloudflare R2 originals and signed playback
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=duna
CF_ACCESS_KEY_ID=
CE_SECRET_ACCESS_KEY=
# Optional Cloudflare account API token for operations; not used for S3 uploads.
CF_TOKEN_VALUE=
# Server-side deployment aliases currently accepted during the R2 rollout:
# cloudflare_account_id, cf_r2_access_key_id, cf_r2_secret_access_key,
# and cf_rs_s3_endpoint. Prefer the canonical names above for new environments.

# Duna Vision analysis worker — server-only callback and dispatch credentials.
# The worker writes model artifacts to the private video-analysis/{videoId}/ R2 prefix.
DUNA_ANALYSIS_WORKER_URL=
DUNA_ANALYSIS_WORKER_TOKEN=
# Modal operations endpoint used by Super Admin for validation and training jobs.
DUNA_VISION_OPERATIONS_URL=
# Ed25519 public key used to verify immutable model promotion attestations.
DUNA_VISION_ATTESTATION_PUBLIC_KEY_PEM=

# Higgsfield artwork processing — a server-scoped developer token and workspace.
# Never expose either value in native/web clients or source control.
HIGGSFIELD_API_TOKEN=
HIGGSFIELD_WORKSPACE_ID=
# Optional; defaults to Higgsfield's production developer endpoint.
HIGGSFIELD_API_URL=

# LiveKit voice onboarding and coach session notes
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Apple Live Activities
APNS_TEAM_ID=
APNS_KEY_ID=
# Paste the complete .p8 value; escaped \n newlines are accepted.
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=com.duna.player
APNS_PLAYER_BUNDLE_ID=com.duna.player
APNS_PRO_BUNDLE_ID=com.duna.pro

# Messaging and workflows
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
KNOCK_SECRET_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SENT_DM_API=
SENT_DM_BOOKING_INVITE_TEMPLATE_ID=
SENT_DM_BOOKING_INVITE_TEMPLATE_NAME=duna_court_booking_invite
SENT_DM_MATCH_INVITE_TEMPLATE_NAME=
SENT_DM_PLAYER_INVITE_TEMPLATE_NAME=
SENT_DM_STAFF_INVITE_TEMPLATE_NAME=
SENT_DM_TEAM_INVITE_TEMPLATE_NAME=duna_team_event_invite
SENT_DM_SANDBOX=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Realtime, storage, and observability
# Messaging correctness comes from Neon cursor sync. Upstash only supplies
# best-effort wake-up hints; keep both values server-only.
MESSAGING_SSE_ENABLED=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional per-project Expo Push access tokens when enhanced push security is
# enabled. EXPO_ACCESS_TOKEN remains a single-project fallback.
EXPO_PLAYER_ACCESS_TOKEN=
EXPO_PRO_ACCESS_TOKEN=
EXPO_ACCESS_TOKEN=
BLOB_READ_WRITE_TOKEN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
AXIOM_TOKEN=
